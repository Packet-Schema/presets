{
  "name": "@packet-schema/presets",
  "version": "0.1.1",
  "description": "Built-in PSDL presets for Packet Schema (TCP, UDP, IPv4/6, TLS, QUIC, DNS, …)",
  "license": "MIT",
  "author": "Taquan Aoki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Packet-Schema/presets.git"
  },
  "homepage": "https://github.com/Packet-Schema/presets#readme",
  "bugs": {
    "url": "https://github.com/Packet-Schema/presets/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "presets"
  ],
  "scripts": {
    "build:presets": "tsx scripts/build.ts",
    "build": "npm run build:presets && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "npm run build:presets",
    "check": "tsx scripts/check.ts && tsx scripts/semcheck.ts && tsx scripts/taxcheck.ts && tsx scripts/normcheck.ts",
    "check:schema": "tsx scripts/check.ts",
    "check:semantic": "tsx scripts/semcheck.ts",
    "check:taxonomy": "tsx scripts/taxcheck.ts",
    "check:normalize": "tsx scripts/normcheck.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@packet-schema/core": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "yaml": "^2.7.1"
  }
}
